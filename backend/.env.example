# ===== [SEÇÃO: CONFIGURAÇÕES DE AMBIENTE] =====
# EDITAR AQUI: valores para desenvolvimento local ou produção
PROJECT_NAME="BROLABS TECH API"
ENV="development"
DEBUG=true

# Banco de dados: SQLite em dev, PostgreSQL em prod
DATABASE_URL="sqlite:///./brolabs.db"

# Segurança e JWT
# Gere um segredo forte em prod com: openssl rand -hex 32
SECRET_KEY="troque_esta_chave_secreta_por_uma_aleatoria_em_producao"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS & Origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Administrador inicial para script de seed
# python -m app.seed
ADMIN_EMAIL="admin@brolabs.tech"
ADMIN_PASSWORD="troque_esta_senha_forte_123"

# Armazenamento e uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5

# Contato
# TODO(brolabs): configurar e-mail de destino real da empresa
CONTACT_DEST_EMAIL="contato@brolabs.tech"

# Integração server-side com OpenRouter (nunca configure a chave no frontend)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-oss-120b"
